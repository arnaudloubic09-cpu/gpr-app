# ── Base de données / services (docker compose) ──
DATABASE_URL=postgresql://gpr:gpr@localhost:5432/gpr?schema=public
REDIS_URL=redis://localhost:6379

# ── API ──
API_PORT=3000
NODE_ENV=development
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:3001

# ── Tâches planifiées (BullMQ) ──
JOBS_ENABLED=true
SYNC_LOOKBACK_DAYS=7

# ── Auth ── (générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_PEPPER=change-me
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_MINUTES=10

# ── Chiffrement des identifiants connecteurs (32 octets en base64) ──
# générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTOR_ENCRYPTION_KEY=change-me

# ── Emails (Mailpit en dev : http://localhost:8025) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="GPR <no-reply@gpr.local>"

# ── Connecteurs réels (phase 6, à compléter avec la documentation officielle) ──
# PLAYTOMIC_*=
# DOINSPORT_*=

# ── Back-office (apps/admin) ──
API_URL=http://localhost:3000

# ── App mobile (apps/mobile) ──
EXPO_PUBLIC_API_URL=http://localhost:3000
