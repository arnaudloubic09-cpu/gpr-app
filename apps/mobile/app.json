{
  "expo": {
    "name": "GPR",
    "slug": "gpr-padel",
    "scheme": "gpr",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "fr.gpr.padel"
    },
    "android": {
      "package": "fr.gpr.padel"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": null
      }
    }
  }
}
