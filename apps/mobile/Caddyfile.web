:80 {
	root * /srv
	encode gzip
	# Application monopage : toutes les routes renvoient index.html
	try_files {path} /index.html
	file_server
	header /_expo/* Cache-Control "public, max-age=31536000, immutable"
	# La page d'accueil est toujours revérifiée : chaque mise à jour est visible sans vider le cache
	@html not path /_expo/* /assets/*
	header @html Cache-Control "no-cache"
}
