{
  "name": "gpr",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm --filter @gpr/api build && pnpm --filter @gpr/admin build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "format": "prettier --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @gpr/api prisma:migrate",
    "db:seed": "pnpm --filter @gpr/api prisma:seed",
    "db:reset": "pnpm --filter @gpr/api prisma:reset",
    "dev:api": "pnpm --filter @gpr/api dev",
    "dev:admin": "pnpm --filter @gpr/admin dev",
    "dev:mobile": "pnpm --filter @gpr/mobile start",
    "build:packages": "pnpm --filter @gpr/core build && pnpm --filter @gpr/connectors build",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "~5.8.3"
  }
}
