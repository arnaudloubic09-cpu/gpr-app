# ─────────────────────────────────────────────────────────────────────────────
# Variables d'un environnement GPR (préproduction ou production).
# Copier en deploy/.env sur le serveur. Ne JAMAIS committer ce fichier rempli.
# Générer chaque secret avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

# preproduction | production (sert à nommer les conteneurs)
GPR_ENV=preproduction

# Noms de domaine (enregistrements DNS A/AAAA pointant vers le serveur)
API_DOMAIN=api.preprod.exemple-gpr.fr
ADMIN_DOMAIN=admin.preprod.exemple-gpr.fr
ACME_EMAIL=tech@exemple-gpr.fr

# Base de données (managée recommandée, hébergée dans l'UE)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://gpr:MOT_DE_PASSE@postgres:5432/gpr?schema=public

# Origine autorisée (adresse du back-office)
CORS_ORIGINS=https://admin.preprod.exemple-gpr.fr

# Secrets (différents en préproduction et en production)
JWT_ACCESS_SECRET=
OTP_PEPPER=
# 32 octets en base64 : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠ À conserver précieusement : sans elle, les identifiants des connecteurs sont illisibles.
CONNECTOR_ENCRYPTION_KEY=

# Emails (fournisseur transactionnel, ex. Brevo : smtp-relay.brevo.com, port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GPR <no-reply@exemple-gpr.fr>"

# Tâches planifiées et notifications
JOBS_ENABLED=true
SYNC_LOOKBACK_DAYS=7
# log (simulé) en préproduction ; expo en production (compte Expo/EAS requis)
PUSH_PROVIDER=log

API_PORT=3000
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_MINUTES=10
